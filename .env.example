# App/CORS
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Runtime mode is selected by npm run start:dev or npm run start:prod (--env); NODE_ENV is not read directly.
# Keep 0 for direct local access. Set 1 when Render is the single reverse proxy.
TRUST_PROXY_HOPS=0

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=x_clone
# If MONGODB_URI is blank, the runtime instead requires DB_CLUSTER_HOST, DB_USERNAME, and DB_PASSWORD.
# DB_CLUSTER_HOST=your-cluster.mongodb.net
# DB_USERNAME=replace-with-your-database-user
# DB_PASSWORD=replace-with-your-database-password
# Collection overrides are optional; the values below show the built-in defaults.
# DB_USERS_COLLECTION=users
# DB_REFRESH_TOKEN_COLLECTION=refresh-token
# DB_FOLLOWERS_COLLECTION=followers
# DB_TWEETS_COLLECTION=tweets
# DB_HASHTAGS_COLLECTION=hashtags
# DB_BOOKMARKS_COLLECTION=bookmarks
# DB_LIKES_COLLECTION=likes
# DB_MESSAGES_COLLECTION=messages
# DB_DIRECT_CONVERSATIONS_COLLECTION=direct-conversations
# DB_GROUP_CONVERSATIONS_COLLECTION=group-conversations
# DB_USER_BLOCKS_COLLECTION=user-blocks
# DB_MEDIAS_COLLECTION=medias
# DB_NEWSFEEDS_COLLECTION=newsFeeds
# DB_NOTIFICATIONS_COLLECTION=notifications
# DB_OUTBOX_EVENTS_COLLECTION=outboxEvents
# DB_NOTIFICATION_STATES_COLLECTION=notificationStates
# DB_NOTIFICATION_ACTORS_COLLECTION=notificationActors
# DB_NOTIFICATION_LIFECYCLE_GUARDS_COLLECTION=notificationLifecycleGuards
# DB_CONVERSATION_READ_STATES_COLLECTION=conversationReadStates
# DB_USER_MESSAGE_STATES_COLLECTION=userMessageStates

# Redis
REDIS_URL=redis://127.0.0.1:6379
# Phase 6 will consume this optional single-instance adapter flag:
# SOCKET_REDIS_ADAPTER_ENABLED=false

# Notification feature flags (optional; all default to true)
NOTIFICATION_OUTBOX_ENABLED=true
NOTIFICATION_FOLLOW_OUTBOX_ENABLED=true
NOTIFICATION_TWEET_OUTBOX_ENABLED=true
NOTIFICATION_SOCIAL_AGGREGATION_ENABLED=true
NOTIFICATION_MESSAGE_DIRECTED_ENABLED=true
NOTIFICATION_GROUP_MANAGEMENT_ENABLED=true
NOTIFICATION_FOLLOWED_TWEET_ENABLED=true

# Auth secrets + expiry
# Generate independent values for the two secrets; do not reuse these placeholders.
JWT_SECRET_ACCESS_TOKEN=replace-with-an-independent-strong-random-secret
JWT_SECRET_REFRESH_TOKEN=replace-with-another-independent-strong-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary/media limits
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
# Phase 6 will consume these optional upload limits:
# MAX_IMAGE_UPLOAD_MB=10
# MAX_VIDEO_UPLOAD_MB=20
# MAX_AUDIO_UPLOAD_MB=10

# Conversation (optional; defaults to 500)
MAX_GROUP_MEMBERS=500
